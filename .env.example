# Orchestrator bind
HOST=127.0.0.1
PORT=8787

# Discord interactions (required when using /webhooks/discord/interactions)
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional verification token if you later build custom adapters
DISCORD_VERIFY_TOKEN=

# Eastmoney local bridge (simulation by default)
EASTMONEY_BRIDGE_ENDPOINT=http://127.0.0.1:8099/eastmoney-sim/order
EASTMONEY_BRIDGE_SIMULATE=true

# TradingAgents adapter
# fallback (default): use internal mock/fallback insights
# python-proxy: call backend/scripts/tradingagents_proxy.py (you still need TradingAgents deps + API keys to make it real)
TRADINGAGENTS_ADAPTER_MODE=fallback
