# Copy this file to .env.local and fill your values. Do NOT commit .env.local.

# GLM (OpenAI-compatible)
TRADINGAGENTS_ADAPTER_MODE=python-proxy
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_BACKEND_URL=https://api.z.ai/api/paas/v4/
OPENAI_API_KEY=replace_with_your_glm_key
TRADINGAGENTS_DEEP_MODEL=GLM-5
TRADINGAGENTS_QUICK_MODEL=GLM-5

# A-share symbol mapping for yfinance compatibility
TRADINGAGENTS_SYMBOL_MAP={"600519.SH":"600519.SS"}

# Make TradingAgents fail fast if provider hangs
TRADINGAGENTS_PROXY_TIMEOUT_SECS=30
TRADINGAGENTS_PROXY_TIMEOUT_MS=35000
TRADINGAGENTS_SELECTED_ANALYSTS=market,news

# Bridge config (orchestrator will read these on startup)
EASTMONEY_BRIDGE_ENDPOINT=http://127.0.0.1:8100/eastmoney-sim/order
EASTMONEY_BRIDGE_SIMULATE=false

# OpenClaw webhook auth (optional but recommended)
# If set, call /webhooks/openclaw with Authorization: Bearer <secret>
OPENCLAW_SHARED_SECRET=

# Discord bot / slash commands (fill these from Discord Developer Portal)
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
